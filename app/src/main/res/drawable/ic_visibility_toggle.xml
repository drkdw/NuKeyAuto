<?xml version="1.0" encoding="utf-8"?>
<!--
  Stateful drawable for the password-visibility toggle in TextInputLayout.
  checked = password is visible  → show "hide" icon
  default = password is hidden   → show "show" icon
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/ic_visibility_off" android:state_checked="true" />
    <item android:drawable="@drawable/ic_visibility" />
</selector>

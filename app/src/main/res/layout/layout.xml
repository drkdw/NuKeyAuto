<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center">

    <EditText android:id="@+id/etToken" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="API Token"/>
    <EditText android:id="@+id/etId" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="SmartLock ID"/>
    <Button android:id="@+id/btnSave" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Opslaan en Testen"/>

    <TextView android:id="@+id/tvStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Status: ..." android:textSize="24sp" android:layout_marginTop="32dp"/>
    <Button android:id="@+id/btnAction" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Actie" android:layout_marginTop="16dp"/>
</LinearLayout>
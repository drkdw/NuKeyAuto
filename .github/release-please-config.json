{
	"bootstrap-sha": "c81a9703f2df87dddb6e96cbab7d2750428f74ac",
	"include-component-in-tag": false,
	"include-v-in-tag": false,
	"changelog-sections": [
		{ "type": "feat", "section": "🚀 Features" },
		{ "type": "fix", "section": "🐛 Bug fixes" },
		{ "type": "refactor", "section": "🛠️ Refactoring" },
		{ "type": "style", "hidden": true },
		{ "type": "chore", "hidden": true },
		{ "type": "docs", "hidden": true },
		{ "type": "perf", "hidden": true },
		{ "type": "test", "hidden": true },
		{ "type": "ci", "hidden": true },
		{ "type": "build", "hidden": true }
	],
	"plugins": [
		{ "type": "sentence-case" }
	],
	"packages": {
		".": {
			"release-type": "simple",
			"package-name": "nukeyauto",
			"pull-request-title-pattern": "chore(release): ${version}",
			"pull-request-header": ":construction: NuKey Auto :construction:",
			"pull-request-footer": "Merging this PR tags the release and creates the GitHub release. Build and upload the AAB to Google Play from the tag.",
			"extra-files": ["app/build.gradle.kts"]
		}
	},
	"$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json"
}
